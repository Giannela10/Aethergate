[sub_resource type="Shader" id="merge_local_Shader_v7i8e"]
code = "shader_type spatial; varying vec3 world; void vertex(){world=(MODEL_MATRIX*vec4(VERTEX,1.0)).xyz;} void fragment(){vec2 f=fract(world.xz*0.75); float joint=max(step(0.985,f.x),step(0.985,f.y)); ALBEDO=mix(vec3(0.095,0.085,0.075),vec3(0.25,0.23,0.21),joint); ROUGHNESS=0.28;}"

